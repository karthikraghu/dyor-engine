# Trader Engine Configuration
# Copy this file to .env and adjust values

# Exchange settings
EXCHANGE_ID=binance
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h

# Data settings
DATA_DIR=./data
OHLCV_LIMIT=1000

# Sandbox settings
SANDBOX_HOST=0.0.0.0
SANDBOX_PORT=8000

# Redis (Phase 2+)
REDIS_URL=redis://localhost:6379
